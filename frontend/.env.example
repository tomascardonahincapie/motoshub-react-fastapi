# ---------------------------------------------------------------------------
# Copia este archivo como .env y ajusta el valor.
# Vite solo expone al navegador las variables que empiezan por VITE_.
#
# Por eso aqui NUNCA se pone una API Key: todo lo que este en este archivo
# acaba dentro del JavaScript que descarga cualquier visitante. Las claves
# viven en el .env del Backend.
# ---------------------------------------------------------------------------

# Direccion del Backend. En desarrollo, con FastAPI en el puerto 8000:
VITE_API_URL=http://localhost:8000/api

# En produccion apunta al dominio publico del Backend, por ejemplo:
# VITE_API_URL=https://motoshub-api.up.railway.app/api
