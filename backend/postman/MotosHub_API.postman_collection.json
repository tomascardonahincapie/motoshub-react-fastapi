              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "const datos = pm.response.json();",
                  "pm.test('Devuelve el usuario creado', () => pm.expect(datos.usuario).to.have.property('id_usuario'));",
                  "pm.collectionVariables.set('id_usuario', datos.usuario.id_usuario);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Tomas\",\n  \"apellidos\": \"Cardona\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"1035123456\",\n  \"direccion\": \"Calle 10 #45-20\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"tomas@correo.com\",\n  \"password\": \"Clave123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios/registro",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "registro"]
            },
            "description": "Registra un cliente. El Backend valida los datos, comprueba que el correo y el documento no esten duplicados y guarda la contrasena como hash bcrypt."
          }
        },
