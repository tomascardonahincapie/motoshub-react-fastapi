# ---------------------------------------------------------------------------
# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO debe subirse al repositorio (ver .gitignore).
# ---------------------------------------------------------------------------

# Aplicacion
NOMBRE_APP=API MotosHub
ENTORNO=desarrollo
DEPURACION=true

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bd_jhm_tech_solutions

# Seguridad (cambia JWT_SECRET por un valor largo y aleatorio)
JWT_SECRET=jhm_tech_secret_2026_cambiar_en_produccion
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=480

# Vigencia del enlace de recuperacion de contrasena, en minutos
RECUPERACION_EXPIRA_MINUTOS=30

# URL del Frontend, usada para armar el enlace de recuperacion
URL_FRONTEND=http://localhost:5173

# Origenes autorizados para CORS (donde corre el Frontend de Vite)
ORIGENES_PERMITIDOS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Servidor de correo (SMTP) para el enlace de recuperacion de contrasena.
# Si se dejan vacios, el enlace se escribe en la consola de uvicorn.
#
# Gmail: crea una CONTRASENA DE APLICACION en
#   https://myaccount.google.com/apppasswords
# (requiere tener activada la verificacion en dos pasos).
# No uses la contrasena normal de tu correo: Google la rechaza.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=MotosHub <no-reply@motoshub.com>
SMTP_TLS=true
SMTP_SSL=false

# ---------------------------------------------------------------------------
# Facturacion
# ---------------------------------------------------------------------------
# IVA general en Colombia. Se aplica sobre la base gravable de cada venta.
IVA_PORCENTAJE=19

# Datos que aparecen en el encabezado de las facturas y de los reportes
NEGOCIO_NOMBRE=MotosHub
NEGOCIO_NIT=901.456.789-1
NEGOCIO_DIRECCION=Cra. 45 #12-30
NEGOCIO_CIUDAD=Medellin, Colombia
NEGOCIO_TELEFONO=+57 300 000 0000
NEGOCIO_EMAIL=contacto@motoshub.com

# ---------------------------------------------------------------------------
# Inteligencia Artificial del chatbot
#
# IMPORTANTE: la API Key es privada. Va SOLO en el archivo .env, que esta en
# .gitignore y nunca se sube a GitHub. Si alguna vez se publica por error, hay
# que revocarla de inmediato en el panel del proveedor.
#
# Sin IA_API_KEY el chatbot sigue funcionando con su motor de reglas, que
# consulta la misma base de datos.
#
# Proveedores admitidos:
#   anthropic -> API de Claude          https://console.anthropic.com
#   openai    -> API de OpenAI y cualquier otra compatible con
#                /chat/completions (Groq, OpenRouter, DeepSeek, Together...),
#                cambiando IA_URL_BASE
# ---------------------------------------------------------------------------
IA_PROVEEDOR=ninguno
IA_API_KEY=
IA_MODELO=
IA_URL_BASE=
IA_MAX_TOKENS=600
IA_TEMPERATURA=0.4
IA_TIEMPO_ESPERA=30

# ---------------------------------------------------------------------------
# Despliegue (Railway, Render, Fly...)
# ---------------------------------------------------------------------------
# La plataforma entrega la base de datos en una sola variable. Si DATABASE_URL
# tiene valor, manda sobre DB_HOST, DB_USER y compania.
# DATABASE_URL=mysql://usuario:clave@host:puerto/base

# En produccion, ORIGENES_PERMITIDOS y URL_FRONTEND deben apuntar al dominio
# publico del Frontend. Se admite una lista separada por comas:
# ORIGENES_PERMITIDOS=https://motoshub.up.railway.app
# URL_FRONTEND=https://motoshub.up.railway.app
# ENTORNO=produccion
# DEPURACION=false
